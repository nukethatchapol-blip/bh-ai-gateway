# --- Supabase ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used to AES-256 encrypt user-supplied provider API keys at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENC_SECRET=base64-32-byte-secret

# --- Optional team-pool fallback keys (used when user has no BYO key) -----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Application URL (used for OAuth redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
